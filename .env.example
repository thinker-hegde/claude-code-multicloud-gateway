# ==============================================================================
# Universal Multi-Cloud AI Gateway — Environment Configuration
# ==============================================================================
# Set these in your System/User Environment Variables ($env:VARIABLE in PowerShell)
# or copy this file to `.env` in the repository root.
# ==============================================================================

# Tier 1: NVIDIA NIM Cloud (Flagship 120B Super Model @ 107 tok/s)
# Get free key (1,000 credits): https://build.nvidia.com
NVIDIA_API_KEY="your_nvidia_api_key_here"

# Tier 2: Groq Cloud LPU (Ultra-Fast 120B / 70B @ 200-350 tok/s)
# Get free key (100% Free Forever): https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Tier 3: Google Gemini API (Gemini 3.6 Flash / 1M Context @ 1,500 req/day)
# Get free key (100% Free Forever): https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Tier 4: Local Ollama Server (100% Offline & Infinite Backup)
# Download: https://ollama.com
OLLAMA_HOST="http://127.0.0.1:11434"

# Gateway Port Configuration
PORT=8000
HOST="127.0.0.1"
